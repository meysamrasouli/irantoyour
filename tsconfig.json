{
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2020", "DOM"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["resources/js/*"],
            "@scss/*": ["resources/scss/*"]
        },
        "types": ["vite/client"]
    },
    "include": ["resources/js/**/*"]
}
